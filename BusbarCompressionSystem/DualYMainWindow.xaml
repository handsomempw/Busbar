<p:WindowX x:Class="BusbarCompressionSystem.DualYMainWindow"
           xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           xmlns:p="https://opensource.panuon.com/wpf-ui"
           xmlns:view="clr-namespace:BusbarCompressionSystem.View"
           Title="法拉电子-母排压合系统 · 双Y小屏"
           Width="1024"
           Height="768"
           MinWidth="800"
           MinHeight="600"
           WindowState="Maximized"
           UseLayoutRounding="True"
           WindowStartupLocation="CenterScreen"
           Loaded="Window_Loaded"
           Closing="Window_Closing">
    <Grid Background="#F2F4F6">
        <Grid.RowDefinitions>
            <RowDefinition Height="46"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#20272B" Padding="12,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="双Y并行电测" Foreground="White" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="20,0" VerticalAlignment="Center">
                    <TextBlock Text="当前规格" Foreground="#90A4AE"/>
                    <TextBlock Margin="8,0,0,0" Foreground="White" FontWeight="SemiBold"
                               Text="{Binding Processmodel.PartNOID, TargetNullValue=--}"/>
                </StackPanel>
                <Border Grid.Column="2" Margin="4,0,8,0" Padding="10,4" Background="#37474F" CornerRadius="4">
                    <TextBlock Foreground="White" FontWeight="SemiBold" Text="{Binding Processmodel.DualYElectricalTestModeDisplay}"/>
                </Border>
                <Button Grid.Column="3" Margin="4,0" Padding="12,5" Content="系统设置" ToolTip="打开设备和系统配置" Click="OpenSettings_Click"/>
                <Button Grid.Column="4" Margin="4,0" Padding="12,5" Background="#1565C0" Foreground="White" BorderBrush="#1565C0"
                        Content="参数下发" ToolTip="输入生产批号并从MES获取工艺参数" Click="OpenParameterDownload_Click"/>
            </Grid>
        </Border>

        <view:DualYProductionView Grid.Row="1"/>
    </Grid>
</p:WindowX>
