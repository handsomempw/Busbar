<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!-- 离线/内网可还原：第三方包统一放在 third_party/nuget -->
    <add key="third_party" value="third_party\nuget" />
    <!-- 可选：保留 nuget.org，离线环境会自动失败但不影响本地源 -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
