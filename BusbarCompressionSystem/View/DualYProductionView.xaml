<UserControl x:Class="BusbarCompressionSystem.View.DualYProductionView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DesignHeight="700"
             d:DesignWidth="1280"
             Background="#F2F4F6"
             FontSize="13">
    <UserControl.Resources>
        <Style x:Key="SurfaceBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#CED4DA"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12"/>
        </Style>
        <Style x:Key="SignalBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="#D9DEE3"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C9D0D6"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="CanUserDeleteRows" Value="False"/>
            <Setter Property="CanUserReorderColumns" Value="False"/>
            <Setter Property="CanUserResizeRows" Value="False"/>
            <Setter Property="CanUserSortColumns" Value="False"/>
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E7EAED"/>
            <Setter Property="RowHeight" Value="30"/>
            <Setter Property="ColumnHeaderHeight" Value="32"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E2E7EB"/>
            <Setter Property="Foreground" Value="#1F2D33"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
            <Setter Property="BorderBrush" Value="#AEB8BF"/>
            <Setter Property="BorderThickness" Value="0,0,1,1"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Padding" Value="4,0"/>
        </Style>
    </UserControl.Resources>

    <Grid Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="170"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="112"/>
            <RowDefinition Height="26"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="8"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{StaticResource SurfaceBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Y1 工位" FontSize="18" FontWeight="Bold" Foreground="#1565C0"/>
                        <Button x:Name="Y1ManualScanButton" Grid.Column="2" Tag="1" Width="30" Height="28" Margin="8,0"
                                Background="#ECEFF1" BorderBrush="#B0BEC5" FontFamily="Segoe UI Symbol" FontSize="16"
                                Content="&#x2328;" ToolTip="Y1手动扫码" Click="ManualScanToggle_Click"/>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#37474F"
                                   Text="{Binding Processmodel.DualYStation1Display.WorkflowState}"/>
                        <Popup x:Name="Y1ManualScanPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=Y1ManualScanButton}"
                               HorizontalOffset="-350" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Width="390" Style="{StaticResource SurfaceBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Y1 手动扫码" FontWeight="SemiBold" Foreground="#1565C0" Margin="0,0,0,8"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="产品编号" VerticalAlignment="Center" Foreground="#455A64"/>
                                        <TextBox x:Name="Y1ManualScanTextBox" Grid.Column="1" Tag="1" Height="34" Margin="8,0"
                                                 MaxLength="80" VerticalContentAlignment="Center" Padding="8,0"
                                                 ToolTip="输入或扫描Y1产品编号" PreviewKeyDown="ManualScanTextBox_PreviewKeyDown"/>
                                        <Button x:Name="Y1ManualScanSubmitButton" Grid.Column="2" Tag="1" Height="34"
                                                Background="#1565C0" Foreground="White" BorderBrush="#1565C0"
                                                FontFamily="Segoe UI Symbol" FontSize="17" Content="&#x2713;"
                                                ToolTip="提交Y1扫码" Click="ManualScanSubmit_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="Y1ManualScanMessage" Grid.Row="2" Margin="0,7,0,0" Foreground="#C62828"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SN" Foreground="#607D8B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Processmodel.DualYStation1Display.CurrentSn, TargetNullValue=--}" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="工单" Foreground="#607D8B" VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding Processmodel.DualYStation1Display.CurrentWoCode, TargetNullValue=--}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <UniformGrid Grid.Row="2" Columns="4">
                        <Border Style="{StaticResource SignalBorder}" Background="{Binding Processmodel.Scan_Trig_IO.IOstatusBackGround}">
                            <TextBlock HorizontalAlignment="Center" Foreground="{Binding Processmodel.Scan_Trig_IO.IOStatusForeGround}"
                                       Text="{Binding Processmodel.Scan_Trig_IO.IOstatus, StringFormat=扫码 {0}}"/>
                        </Border>
                        <Border Style="{StaticResource SignalBorder}" Background="{Binding Processmodel.Res1_Trig_IO.IOstatusBackGround}">
                            <TextBlock HorizontalAlignment="Center" Foreground="{Binding Processmodel.Res1_Trig_IO.IOStatusForeGround}"
                                       Text="{Binding Processmodel.Res1_Trig_IO.IOstatus, StringFormat=阻值 {0}}"/>
                        </Border>
                        <Border Style="{StaticResource SignalBorder}" Background="{Binding Processmodel.TV1_Trig_IO.IOstatusBackGround}">
                            <TextBlock HorizontalAlignment="Center" Foreground="{Binding Processmodel.TV1_Trig_IO.IOStatusForeGround}"
                                       Text="{Binding Processmodel.TV1_Trig_IO.IOstatus, StringFormat=耐压 {0}}"/>
                        </Border>
                        <Border Style="{StaticResource SignalBorder}" Background="{Binding Processmodel.DualYStation1FlowEnd_Trig_IO.IOstatusBackGround}">
                            <TextBlock HorizontalAlignment="Center" Foreground="{Binding Processmodel.DualYStation1FlowEnd_Trig_IO.IOStatusForeGround}"
                                       Text="{Binding Processmodel.DualYStation1FlowEnd_Trig_IO.IOstatus, StringFormat=归档 {0}}"/>
                        </Border>
                    </UniformGrid>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="测试模式" Foreground="#607D8B" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Margin="8,0" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Text="{Binding Processmodel.CurrentTV1TestModeDisplay}"/>
                        <TextBlock Grid.Column="2" Text="最近结果" Foreground="#607D8B" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Processmodel.DualYStation1Display.LastResult}"/>
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource SurfaceBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="48"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Y2 工位" FontSize="18" FontWeight="Bold" Foreground="#7B1FA2"/>
                        <Button x:Name="Y2ManualScanButton" Grid.Column="2" Tag="2" Width="30" Height="28" Margin="8,0"
                                Background="#F3E5F5" BorderBrush="#CE93D8" FontFamily="Segoe UI Symbol" FontSize="16"
                                Content="&#x2328;" ToolTip="Y2手动扫码" Click="ManualScanToggle_Click"/>
                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="#37474F"
                                   Text="{Binding Processmodel.DualYStation2Display.WorkflowState}"/>
                        <Popup x:Name="Y2ManualScanPopup" Placement="Bottom" PlacementTarget="{Binding ElementName=Y2ManualScanButton}"
                               HorizontalOffset="-350" VerticalOffset="4" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                            <Border Width="390" Style="{StaticResource SurfaceBorder}">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="Auto"/>
                                    </Grid.RowDefinitions>
                                    <TextBlock Grid.Row="0" Text="Y2 手动扫码" FontWeight="SemiBold" Foreground="#7B1FA2" Margin="0,0,0,8"/>
                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="36"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="产品编号" VerticalAlignment="Center" Foreground="#455A64"/>
                                        <TextBox x:Name="Y2ManualScanTextBox" Grid.Column="1" Tag="2" Height="34" Margin="8,0"
                                                 MaxLength="80" VerticalContentAlignment="Center" Padding="8,0"
                                                 ToolTip="输入或扫描Y2产品编号" PreviewKeyDown="ManualScanTextBox_PreviewKeyDown"/>
                                        <Button x:Name="Y2ManualScanSubmitButton" Grid.Column="2" Tag="2" Height="34"
                                                Background="#7B1FA2" Foreground="White" BorderBrush="#7B1FA2"
                                                FontFamily="Segoe UI Symbol" FontSize="17" Content="&#x2713;"
                                                ToolTip="提交Y2扫码" Click="ManualScanSubmit_Click"/>
                                    </Grid>
                                    <TextBlock x:Name="Y2ManualScanMessage" Grid.Row="2" Margin="0,7,0,0" Foreground="#C62828"
                                               TextWrapping="Wrap"/>
                                </Grid>
                            </Border>
                        </Popup>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="160"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="SN" Foreground="#607D8B" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding Processmodel.DualYStation2Display.CurrentSn, TargetNullValue=--}" FontSize="18" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="2" Text="工单" Foreground="#607D8B" VerticalAlignment="Center" Margin="12,0,8,0"/>
                        <TextBlock Grid.Column="3" Text="{Binding Processmodel.DualYStation2Display.CurrentWoCode, TargetNullValue=--}"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                    </Grid>
                    <UniformGrid Grid.Row="2" Columns="4">
                        <Border Style="{StaticResource SignalBorder}" Background="{Binding Processmodel.DualYStation2Scan_Trig_IO.IOstatusBackGround}">
                            <TextBlock HorizontalAlignment="Center" Foreground="{Binding Processmodel.DualYStation2Scan_Trig_IO.IOStatusForeGround}"
                                       Text="{Binding Processmodel.DualYStation2Scan_Trig_IO.IOstatus, StringFormat=扫码 {0}}"/>
                        </Border>
                        <Border Style="{StaticResource SignalBorder}" Background="{Binding Processmodel.Res2_Trig_IO.IOstatusBackGround}">
                            <TextBlock HorizontalAlignment="Center" Foreground="{Binding Processmodel.Res2_Trig_IO.IOStatusForeGround}"
                                       Text="{Binding Processmodel.Res2_Trig_IO.IOstatus, StringFormat=阻值 {0}}"/>
                        </Border>
                        <Border Style="{StaticResource SignalBorder}" Background="{Binding Processmodel.TV2_Trig_IO.IOstatusBackGround}">
                            <TextBlock HorizontalAlignment="Center" Foreground="{Binding Processmodel.TV2_Trig_IO.IOStatusForeGround}"
                                       Text="{Binding Processmodel.TV2_Trig_IO.IOstatus, StringFormat=耐压 {0}}"/>
                        </Border>
                        <Border Style="{StaticResource SignalBorder}" Background="{Binding Processmodel.DualYStation2FlowEnd_Trig_IO.IOstatusBackGround}">
                            <TextBlock HorizontalAlignment="Center" Foreground="{Binding Processmodel.DualYStation2FlowEnd_Trig_IO.IOStatusForeGround}"
                                       Text="{Binding Processmodel.DualYStation2FlowEnd_Trig_IO.IOstatus, StringFormat=归档 {0}}"/>
                        </Border>
                    </UniformGrid>
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="测试模式" Foreground="#607D8B" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Margin="8,0" FontWeight="SemiBold" VerticalAlignment="Center"
                                   Text="{Binding Processmodel.CurrentTV2TestModeDisplay}"/>
                        <TextBlock Grid.Column="2" Text="最近结果" Foreground="#607D8B" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="3" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                   Text="{Binding Processmodel.DualYStation2Display.LastResult}"/>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="双Y产品过程记录" FontSize="15" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Recordmodel.ProductInfoRecords}" FrozenColumnCount="2"
                      HorizontalScrollBarVisibility="Auto">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="工位" Binding="{Binding StationDisplay}" Width="46"/>
                    <DataGridTextColumn Header="产品编号" Binding="{Binding Productinfo.SN}" Width="150"/>
                    <DataGridTextColumn Header="批号" Binding="{Binding Productinfo.WOCODE}" Width="96"/>
                    <DataGridTextColumn Header="模式" Binding="{Binding TestMode}" Width="50"/>
                    <DataGridTextColumn Header="耐压结果" Binding="{Binding TVResultDisplay}" Width="64"/>
                    <DataGridTextColumn Header="电压(V)" Binding="{Binding TVMaxVoltageDisplay}" Width="70"/>
                    <DataGridTextColumn Header="电流(mA)" Binding="{Binding TVMaxCurrentDisplay}" Width="74"/>
                    <DataGridTextColumn Header="阻值" Binding="{Binding ResDisplay}" Width="62"/>
                    <DataGridTextColumn Header="压力均值" Binding="{Binding PressureAverageDisplay}" Width="72"/>
                    <DataGridTextColumn Header="压力结果" Binding="{Binding PressureResultDisplay}" Width="68"/>
                    <DataGridTextColumn Header="仪器" Binding="{Binding TVMeterID}" Width="78"/>
                    <DataGridTextColumn Header="测试时间" Binding="{Binding DateTime, StringFormat={}{0:MM-dd HH:mm:ss}}" Width="108"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="28"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <TextBlock Grid.Row="0" Text="运行日志" FontSize="15" FontWeight="SemiBold" Foreground="#263238" VerticalAlignment="Center"/>
            <DataGrid Grid.Row="1" ItemsSource="{Binding Recordmodel.workLog}" RowHeight="26" ColumnHeaderHeight="28">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="时间" Binding="{Binding DateTime, StringFormat={}{0:HH:mm:ss.fff}}" Width="115"/>
                    <DataGridTextColumn Header="信息" Binding="{Binding log}" Width="*" MinWidth="400"/>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Margin="4,0,18,0" VerticalAlignment="Center"
                       Text="{Binding Settingmodel.SETTING_DATA.MachineID, StringFormat=设备：{0}}"/>
            <TextBlock Grid.Column="1" Margin="0,0,18,0" VerticalAlignment="Center"
                       Text="{Binding Settingmodel.SETTING_DATA.StationCode, StringFormat=工站：{0}}"/>
            <TextBlock Grid.Column="2" VerticalAlignment="Center"
                       Text="{Binding Settingmodel.CurrentTestModeDisplay, StringFormat=工艺模式：{0}}"/>
            <TextBlock Grid.Column="4" Margin="18,0,4,0" Foreground="#607D8B" VerticalAlignment="Center"
                       Text="界面配置：双Y电测配置.xml"/>
        </Grid>
    </Grid>
</UserControl>
