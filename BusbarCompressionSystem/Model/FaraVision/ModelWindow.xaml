<p:WindowX x:Class="BusbarCompressionSystem.Model.FaraVision.ModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BusbarCompressionSystem.Model.FaraVision"
        xmlns:p="clr-namespace:Panuon.WPF.UI;assembly=Panuon.WPF.UI"
        p:WindowXCaption.Background="#666666"
        p:WindowXCaption.Height="45"  
        WindowStartupLocation="CenterScreen"
           Closing="WindowX_Closing"
       p:WindowXCaption.Foreground="WhiteSmoke"
            xmlns:ctr="clr-namespace:PositionDetect;assembly=PositionDetect"
        Title="模型设置文件" Height="560" Width="900" MinHeight="520" MinWidth="860">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <ctr:UserControl1 Grid.Row="0" x:Name="userctr" DataContext="{Binding Source={StaticResource Locator},Path=PositionDetectViewModel}" />
        <Border Grid.Row="1" Background="#F3F3F3" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="8">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Top" Name="ModelStatusText" Margin="4,0,4,6" FontWeight="Bold" Foreground="#444"
                           Text="模型状态：未导出"/>
                <WrapPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                    <Button Margin="4" Padding="12,6" MinWidth="120" Background="#666666" Foreground="White"
                            p:ButtonHelper.CornerRadius="10" Name="selectFeature" Click="selectFeature_Click"
                            ToolTip="开启模板特征圈选。绿=包含区，品红=排除矩形。每画完一个区域后在图像窗口点鼠标右键完成。">1 选择特征</Button>
                    <Button Margin="4" Padding="12,6" MinWidth="130" Background="Orange" Foreground="White"
                            p:ButtonHelper.CornerRadius="10" Name="previewGenerateModel" Click="previewGenerateModel_Click"
                            IsEnabled="{Binding Source={StaticResource Locator},Path=PositionDetectViewModel.DATA.CanPreviewModel}"
                            ToolTip="按包含区减排除区生成临时模型。红色=实际模型边缘；状态栏显示分值、角度、耗时。">2 预览生成模型</Button>
                    <Button Margin="4" Padding="12,6" MinWidth="130" Background="SeaGreen" Foreground="White"
                            p:ButtonHelper.CornerRadius="10" Name="exportModel" Click="exportModel_Click"
                            IsEnabled="{Binding Source={StaticResource Locator},Path=PositionDetectViewModel.DATA.CanSaveModel}"
                            ToolTip="把当前预览成功的模型保存为 Tool序号.shm，在线检测会读取该文件。">3 保存模型文件</Button>
                    <Button Margin="4" Padding="12,6" MinWidth="130" Background="OrangeRed" Foreground="White"
                            p:ButtonHelper.CornerRadius="10" Name="loadshmfromfile" Click="loadshmfromfile_Click"
                            ToolTip="立即读取工程目录下的 Tool序号.shm；软件启动、照片测试和在线检测会自动检查加载。">4 加载当前模型</Button>
                    <Button Margin="4" Padding="12,6" MinWidth="150" Background="#333333" Foreground="White"
                            p:ButtonHelper.CornerRadius="10" Name="getinitpositionbymodelimage" Click="getinitpositionbymodelimage_Click"
                            ToolTip="用当前工具的角度偏差与候选搜索下限做一次匹配，并写入基准；结果会显示分值、角度、耗时。">5 用模板图设基准点</Button>
                    <Button Margin="4" Padding="12,6" MinWidth="150" Background="#555555" Foreground="White"
                            p:ButtonHelper.CornerRadius="10" Name="getinitpositonfromimagefile" Click="getinitpositonfromimagefile_Click"
                            ToolTip="选择一张现场图片，按当前工具参数匹配后写入基准X/Y；失败时会显示原因、分值与耗时。">用现场图设基准点</Button>
                </WrapPanel>
            </DockPanel>
        </Border>
    </Grid>
</p:WindowX>
