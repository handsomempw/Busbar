<p:WindowX x:Class="BusbarCompressionSystem.SettingForm"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BusbarCompressionSystem"
        xmlns:p="https://opensource.panuon.com/wpf-ui"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
           xmlns:model="clr-namespace:BusbarCompressionSystem.Model"
        mc:Ignorable="d"
        Title="仪器配置" Height="400" Width="420"
        WindowStartupLocation="CenterScreen"
        Loaded="WindowX_Loaded"    
        Closing="WindowX_Closing"
        DataContext="{Binding Source={StaticResource Locator},Path=Main.DataModel}"
        >
    <Grid>
        <Grid.Resources>
            <ObjectDataProvider x:Key="TVmodes" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
                <ObjectDataProvider.MethodParameters>
                    <x:Type Type="model:TVMeterType"/>
                </ObjectDataProvider.MethodParameters>
            </ObjectDataProvider>
        </Grid.Resources>
        <GroupBox Header="仪器配置">
            <Grid>               

                <Grid.RowDefinitions>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                    <RowDefinition Height="auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition/>
                    <ColumnDefinition/>
                </Grid.ColumnDefinitions>

                <CheckBox Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding  Processmodel.TVAvailable.TV1Available}">仪器1:</CheckBox>
                <CheckBox Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding  Processmodel.TVAvailable.TV2Available}">仪器2:</CheckBox>
                <CheckBox x:Name="TV3AvailableCb" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"
                          IsChecked="{Binding Processmodel.TVAvailable.TV3Available}"
                          ToolTip="耐压3启用状态，来源M3032，与IR(M3033)按产品节拍互斥">仪器3:</CheckBox>
                
                <TextBox x:Name="TV1Tb" Grid.Row="0" Grid.Column="1" Margin="5" Text="{Binding Settingmodel.SETTING_DATA.TVMeterID1}" KeyDown="TV1Tb_KeyDown"/>
                <TextBox x:Name="TV2Tb" Grid.Row="1" Grid.Column="1" Margin="5" Text="{Binding Settingmodel.SETTING_DATA.TVMeterID2}" KeyDown="TV2Tb_KeyDown"/>
                <TextBox x:Name="TV3Tb" Grid.Row="2" Grid.Column="1" Margin="5" Text="{Binding Settingmodel.SETTING_DATA.TVMeterID3}" KeyDown="TV3Tb_KeyDown"/>

                <ComboBox IsEditable="true" MinWidth="80" Grid.Row="0" Grid.Column="2" Margin="5"  Text="{Binding Settingmodel.SETTING_DATA.TVMeterType1}" ItemsSource="{Binding  Source={StaticResource  TVmodes}}"/>
                <ComboBox IsEditable="true" MinWidth="80" Grid.Row="1" Grid.Column="2" Margin="5"  Text="{Binding Settingmodel.SETTING_DATA.TVMeterType2}" ItemsSource="{Binding  Source={StaticResource  TVmodes}}"/>
                <ComboBox IsEditable="true" MinWidth="80" Grid.Row="2" Grid.Column="2" Margin="5"  Text="{Binding Settingmodel.SETTING_DATA.TVMeterType3}" ItemsSource="{Binding  Source={StaticResource  TVmodes}}"/>


                <CheckBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,2"
                          IsChecked="{Binding Settingmodel.SETTING_DATA.IrDownloadDebugLog}"
                          ToolTip="打开后会在“日志\\IR串口调试”目录生成详细串口轮询调试日志文件（体积较大，仅排障时开启）">
                    IR参数下发调试日志（生成独立日志文件）
                </CheckBox>

                <CheckBox Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="3" Margin="5,2"
                          IsChecked="{Binding Settingmodel.SETTING_DATA.ReportFailAlarmEnabled}"
                          ToolTip="关闭后报工失败仅记日志，不写 M3045、不弹窗；进站联锁由现场/PLC 自行处理">
                    报工失败报警使能（写禁止进站线圈 + 弹窗）
                </CheckBox>

                <TextBlock Grid.Row="5"  Grid.Column="0" Text="仪器扫描时间:"></TextBlock>
                <TextBlock Grid.Row="5"  Grid.Column="1" Text="{Binding Processmodel.CheckData.TVMeterCheckTime}" ></TextBlock>
                
                
                <Button x:Name="config1"  Grid.Row="6" Grid.ColumnSpan="3" Margin="5"  Padding="10,5"
                         p:ButtonHelper.CornerRadius="15" Foreground="White" Background="Orange"
                         Click="config1_Click"
                        >确定更新仪器配置</Button>
            </Grid>
        </GroupBox>
        
        <!--<Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition/>
            
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition/>
        </Grid.ColumnDefinitions>-->
        
    </Grid>
</p:WindowX>
