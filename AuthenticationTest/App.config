<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- 添加配置节声明 -->
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net" />
  </configSections>

  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8"/>
  </startup>

  <appSettings>
    <!-- 测试模式开关：true=测试模式(不发送实际请求), false=生产模式(连接真实服务器) -->
    <add key="TestMode" value="true"/>
    
    <!-- 设备编号 - 设备的唯一标识符 -->
    <add key="EquipNo" value="E11DMJ000500"/>
    
    <!-- 应用程序名称 - 请求权限的应用程序标识 -->
    <add key="ApplicationName" value="BusbarCompressionSystem"/>
    
    <!-- 默认权限等级 - 数字越大权限越高（1-10） -->
    <add key="DefaultPrivilegeLevel" value="5"/>
    
    <!-- 默认有效期 - 动态密码的有效时间（单位：分钟） -->
    <add key="DefaultPeriod" value="60"/>
    
    <!-- 接收人工号 - 生产环境下指定接收密码的管理员工号 -->
    <add key="ReceiverNo" value="H10009868"/>
    
    <!-- 接收人姓名 - 接收人的姓名（仅用于显示） -->
    <add key="ReceiverName" value="张三"/>
    
    <!-- 测试用密码 - 仅在测试模式下使用 -->
    <add key="TestPassword" value="937345"/>
  </appSettings>

  <!-- 添加 log4net 配置 -->
  <log4net>
    <!-- 控制台输出 -->
    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>

    <!-- 文件输出 -->
    <appender name="FileAppender" type="log4net.Appender.RollingFileAppender">
      <file value="logs\authentication.log" />
      <appendToFile value="true" />
      <rollingStyle value="Date" />
      <datePattern value="yyyyMMdd" />
      <layout type="log4net.Layout.PatternLayout">
        <conversionPattern value="%date [%thread] %-5level %logger - %message%newline" />
      </layout>
    </appender>

    <!-- 根日志配置 -->
    <root>
      <level value="INFO" />
      <appender-ref ref="FileAppender" />
    </root>
  </log4net>
</configuration>