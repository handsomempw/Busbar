<UserControl x:Class="PositionDetect.UserControl1"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:p="https://opensource.panuon.com/wpf-ui"
             xmlns:local="clr-namespace:PositionDetect"
             mc:Ignorable="d" 
             xmlns:halcon="clr-namespace:HalconDotNet;assembly=halcondotnet"
             xmlns:viewmodel="clr-namespace:PositionDetect.ViewModel"
             d:DesignHeight="450"
             d:DesignWidth="800"
             DataContextChanged="UserControl_DataContextChanged"
           >
<Grid Margin="5"   >
        <Grid.ColumnDefinitions>
            <ColumnDefinition/>
            <ColumnDefinition Width="auto"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>
        <halcon:HWindowControlWPF Name="HWindow" Grid.Row="0" Grid.RowSpan="2" />
        <Grid Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" Width="220">
            <GroupBox Header="特征选择">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition/>
                        <ColumnDefinition/>
                    </Grid.ColumnDefinitions>
                    <Button Grid.Row="0" Grid.Column="0" Margin="5" Padding="10" Grid.ColumnSpan="2" Content="{Binding DATA.ROIModeStr}" Click="ToggleFeatureEditing_Click"
                            ToolTip="继续编辑已保存特征或暂停本轮圈选。绿=包含区，品红=排除区；暂停后仍可预览和发布。"/>
                    <Button Grid.Row="1" Grid.Column="0" Margin="5" Padding="8" Content="画包含矩形" IsEnabled="{Binding DATA.ROImode}" Background="{Binding DATA.RectangleMmode}" Click="DrawIncludeRectangle_Click"
                            ToolTip="左键拖出要学习的轮廓区域，合适后点鼠标右键完成。"/>
                    <Button Grid.Row="1" Grid.Column="1" Margin="5" Padding="8" Content="画包含圆形" IsEnabled="{Binding DATA.ROImode}" Background="{Binding DATA.CircleMode}" Click="DrawIncludeCircle_Click"
                            ToolTip="左键拖出圆形包含区，合适后点鼠标右键完成。"/>
                    <Button Grid.Row="2" Grid.Column="0" Margin="5" Padding="8" Grid.ColumnSpan="2" Content="画排除矩形" IsEnabled="{Binding DATA.ROImode}" Background="{Binding DATA.ExcludeRectangleMode}" Click="DrawExcludeRectangle_Click"
                            ToolTip="框住反光、字符、阴影等不要的区域；建模时从包含区中挖掉。列表中显示为“排除-矩形”。"/>
                    <ListBox Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Margin="5" Padding="6" MinHeight="130" ItemsSource="{Binding DATA.Objects}"
                             SelectedIndex="{Binding DATA.selectedindex}"
                             SelectionChanged="FeatureList_SelectionChanged" KeyDown="FeatureList_KeyDown"
                             PreviewMouseRightButtonDown="FeatureList_PreviewMouseRightButtonDown">
                        <ListBox.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="删除选中特征" Click="DeleteSelectedFeature_Click"/>
                            </ContextMenu>
                        </ListBox.ContextMenu>
                    </ListBox>
                    <Button Grid.Row="4" Grid.Column="0" Margin="5" Padding="8" Grid.ColumnSpan="2" Content="删除选中特征"
                            Click="DeleteSelectedFeature_Click"
                            ToolTip="删除列表中当前选中的包含区或排除区；删除后需要重新预览并发布。"/>
                    <Button Grid.Row="5" Grid.Column="0" Margin="5" Padding="8" Grid.ColumnSpan="2" Content="重新示教"
                            IsEnabled="{Binding DATA.HasAnyTemplateFeatures}" Click="ResetTemplateFeatures_Click"
                            ToolTip="清空当前会话中的包含区和排除区。已发布模型继续生效，重新预览并发布后才更新工程模型。"/>
                </Grid>
            </GroupBox>

        </Grid>

    </Grid>
</UserControl>
